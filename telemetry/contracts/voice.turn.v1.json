{
  "schema_version": "voice.turn.v1",
  "note": "What a voice turn sends to Langfuse: root name, trace fields, metadata keys, keys inside metadata blocks, scores and outcomes. A block lists every key it can carry; some are sent only on some turns or text modes. counters, timings_ms, stage_totals_ms and stages are keyed by name and not listed. user_id is the caller's hash, never their phone. pipeline_flags and pc_<step> come from llm_core compact_metadata and are not listed here.",
  "root": "agent_journey",
  "trace_fields": [
    "input",
    "level",
    "output",
    "session_id",
    "status_message",
    "tags",
    "user_id"
  ],
