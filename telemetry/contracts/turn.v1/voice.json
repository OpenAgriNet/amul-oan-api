{
  "schema_version": "turn.v1",
  "pipelines": [
    "telephony"
  ],
  "note": "What a voice turn sends to Langfuse as turn.v1 (amul-telemetry telemetry/turn.v1.yaml): the root, its trace fields, its amul.* metadata keys, the steps opened under it with the metadata each may carry and the fields its output holds, the scores and the outcomes. A metadata key is sent only when its value is known (provider and process_id when the request carried them, farmer_id for a signed-in caller, served_tier once the agent ran, ttft_ms and ttfr_ms once measured). The caller's words (the trace input and output, the text in and out of the steps) are sent only with VOICE_TRACE_TEXT_MODE=full; the user id is the caller's number with VOICE_TRACE_USER_ID_MODE=phone, else its hash, and farmer_id goes out only in the phone mode. level and status_message are set when the turn fails. pydantic-ai's agent-run, model and tool spans nest under the agent step and are not listed.",
  "root": "turn",
  "trace_fields": [
    "input",
    "level",
    "output",
    "session_id",
    "status_message",
    "user_id"
  ],
  "metadata_keys": [
    "amul.direction",
    "amul.farmer_id",
    "amul.kind",
    "amul.outcome",
    "amul.persona",
    "amul.pipeline",
    "amul.pipeline_profile",
    "amul.pipeline_flags",
    "amul.process_id",
    "amul.provider",
    "amul.release",
    "amul.request_epoch",
    "amul.schema_version",
    "amul.served_tier",
    "amul.service",
    "amul.source_lang",
    "amul.target_lang",
    "amul.translation_mode",
    "amul.ttfr_ms",
    "amul.ttft_ms"
  ],
  "steps": {
    "pre_translation": {
      "type": "GENERATION",
      "metadata_keys": [
        "amul.attempts",
        "amul.configured_tier",
        "amul.served_tier"
      ]
    },
    "moderation": {
      "type": "GENERATION",
      "metadata_keys": [
        "amul.attempts",
        "amul.check_mode",
        "amul.configured_tier",
        "amul.served_tier"
      ],
      "output": [
        "category",
        "reason",
        "rejected"
      ]
    },
    "non_meaningful": {
      "type": "GENERATION",
      "metadata_keys": [
        "amul.attempts",
        "amul.check_mode",
        "amul.configured_tier",
        "amul.served_tier"
      ],
      "output": [
        "non_meaningful",
        "reason",
        "streak"
      ]
    },
    "stt_signal_response": {
      "type": "GENERATION",
      "metadata_keys": []
    },
    "greeting_fast_path": {
      "type": "SPAN",
      "metadata_keys": []
    },
    "identity_fast_path": {
      "type": "SPAN",
      "metadata_keys": []
    },
    "fragment_fast_path": {
      "type": "SPAN",
      "metadata_keys": []
    },
    "farmer_context": {
      "type": "SPAN",
      "metadata_keys": [],
      "output": [
        "farmer_info_chars",
        "source",
        "stale",
        "technician_info_chars",
        "unions"
      ]
    },
    "scheme_summary": {
      "type": "SPAN",
      "metadata_keys": []
    },
    "outbound_consent": {
      "type": "GENERATION",
      "metadata_keys": [
        "amul.attempts",
        "amul.check_mode",
        "amul.configured_tier",
        "amul.served_tier"
      ],
      "output": [
        "intent"
      ]
    },
    "milk_readout": {
      "type": "SPAN",
      "metadata_keys": [],
      "output": [
        "source"
      ]
    },
    "agent": {
      "type": "AGENT",
      "metadata_keys": [
        "amul.attempts",
        "amul.configured_tier",
        "amul.served_tier"
      ]
    },
    "post_translation": {
      "type": "GENERATION",
      "metadata_keys": [
        "amul.attempts",
        "amul.configured_tier",
        "amul.served_tier"
      ]
    },
    "nudge": {
      "type": "SPAN",
      "metadata_keys": [],
      "output": [
        "armed",
        "cancel_reason",
        "sent",
        "trigger"
      ]
    }
  },
  "scores": [
    "turn_outcome"
  ],
  "outcomes": [
    "success",
    "error",
    "cancelled",
    "stale_request",
    "stt_signal",
    "hold_message",
    "greeting_fast_path",
    "identity_fast_path",
    "fragment_fast_path",
    "moderation_rejected",
    "non_meaningful_hangup",
    "outbound_declined",
    "outbound_no_data",
    "pretranslation_empty"
  ]
}
