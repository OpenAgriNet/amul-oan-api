    "amul.superseded_by",
    "amul.source_lang",
    "amul.target_lang",
    "amul.translation_mode",
    "amul.utterance_id",
    "amul.ttfr_ms",
    "amul.first_agent_text_ms",
    "amul.first_translation_chunk_ms",
    "amul.ttft_ms",
    "amul.total_ms",
    "amul.agent_ms",
